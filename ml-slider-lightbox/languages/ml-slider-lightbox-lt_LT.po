msgstr ""
"Pasirinkite, kaip filtruoti turinį galerijos apdorojimui, ir nurodykite, "
"kuriuos puslapius, įrašus ar pasirinkimus įtraukti arba išimti."

#: class-ml-slider-lightbox.php:2945
#: class-ml-slider-lightbox.php:2945
msgid "Processing Mode"
msgstr "Apdorojimo režimas"

#: class-ml-slider-lightbox.php:2948
#: class-ml-slider-lightbox.php:2948
msgid "Process all content EXCEPT the items specified below"
msgstr "Apdoroti visą turinį, IŠSKYRUS žemiau nurodytus elementus"

#: class-ml-slider-lightbox.php:2951
#: class-ml-slider-lightbox.php:2951
msgid "ONLY process the items specified below"
msgstr "APDOROTI TIK žemiau nurodytus elementus"

#: class-ml-slider-lightbox.php:2958
#: class-ml-slider-lightbox.php:2958
