msgstr ""
"Natūralus HTML5 viso ekrano palaikymas su klaviatūros sparčiaisiais "
"klavišais (F klavišas) įtraukiančiam peržiūrai."

#: class-ml-slider-lightbox.php:4250 class-ml-slider-lightbox.php:4454
msgid "Enable Rotate"
msgstr "Įjungti sukimosi funkciją"

#: class-ml-slider-lightbox.php:4251
