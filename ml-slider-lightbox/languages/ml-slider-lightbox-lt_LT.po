msgstr ""
"Patobulintas vaizdo palaikymas „YouTube“, „Vimeo“, HTML5 vaizdams su "
"automatinio atkūrimo ir kokybės valdymu."

#: class-ml-slider-lightbox.php:4272 class-ml-slider-lightbox.php:4489
#: class-ml-slider-lightbox.php:4644
msgid "Enable Unique Image URLs"
msgstr "Įjungti unikalius vaizdų URL"

