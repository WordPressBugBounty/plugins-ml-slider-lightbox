msgstr ""
"Cor de fundo para os botões de setas ao passar o mouse. Cria um feedback "
"visual quando os usuários movem o mouse sobre as setas."

#: class-ml-slider-lightbox.php:3426
msgid "Background color for the close button (X) in the gallery."
msgstr "Cor de fundo para o botão de fechar (X) na galeria."

#: class-ml-slider-lightbox.php:3431
msgid ""
"Background color for the close button when hovering. Creates visual "
"feedback when users move their mouse over the close button."
msgstr ""
"Cor de fundo para o botão de fechar ao passar o mouse. Cria um feedback "
"visual quando os usuários movem o mouse sobre o botão de fechar."

#: class-ml-slider-lightbox.php:3436
msgid "Background color for toolbar icons in the lightbox."
msgstr "Cor de fundo para ícones da barra de ferramentas no Lightbox."

#: class-ml-slider-lightbox.php:3441
msgid ""
"Background color for toolbar icons when hovering. Creates visual feedback "
"when users move their mouse over toolbar icons."
msgstr ""
"Cor de fundo para ícones da barra de ferramentas ao passar o mouse. Cria "
"feedback visual quando os usuários movem o mouse sobre os ícones da barra "
"de ferramentas."

