msgstr ""
"Paano mag-align ang teksto ng caption sa loob ng imahen. Nalalapat lamang "
"sa mga caption ng gallery — hindi sa gallery window."

#: class-ml-gallery.php:2545
msgid "Align"
msgstr "I-align"

#: class-ml-gallery.php:2554
msgid ""
"Caption text size. Applies to both gallery thumbnails and the gallery "
