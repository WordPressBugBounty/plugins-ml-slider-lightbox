msgstr "I-customize ang background ng gallery at ang hitsura ng overlay."

#: class-ml-slider-lightbox.php:3353
#: ml-slider-lightbox/class-ml-slider-lightbox.php:3353
msgid "Customize navigation icons (close, previous, next arrows) for gallery."
msgstr ""
"I-customize ang mga icon ng nabigasyon (isara, nakaraan, susunod na mga "
"arrow) para sa gallery."

#: class-ml-slider-lightbox.php:3358
#: ml-slider-lightbox/class-ml-slider-lightbox.php:3358
msgid ""
"Customize the \"Open in Gallery\" buttons that can be added to slides, "
"images, galleries, and videos."
msgstr ""
"I-customize ang mga \"Buksan sa Gallery\" na mga button na maaaring idagdag "
"sa mga slide, larawan, gallery, at mga video."

