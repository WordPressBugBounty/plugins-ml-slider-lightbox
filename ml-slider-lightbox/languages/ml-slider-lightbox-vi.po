msgstr "Chuyển đến mục tiếp theo và tiếp tục phát khi một video kết thúc."

#: class-ml-gallery.php:2292
msgid "Restart each video automatically when it reaches the end."
msgstr "Tự động khởi động lại mỗi video khi nó đến cuối."

#: class-ml-gallery.php:2293
msgid "Play videos without sound."
msgstr "Phát video không có âm thanh."

