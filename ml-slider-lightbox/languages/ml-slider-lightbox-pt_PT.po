msgstr "Na barra de ferramentas de imagem, clique no ícone Editar."

#: class-ml-slider-lightbox.php:6420
msgid "Choose \"Media File\" on the \"Link To\" dropdown."
msgstr "Escolha \"Ficheiro de Media\" no menu suspenso \"Link Para\"."

#: class-ml-slider-lightbox.php:6426
msgid "How to use: CSS Class Method (Advanced)"
msgstr "Como usar: Método da Classe CSS (Avançado)"

