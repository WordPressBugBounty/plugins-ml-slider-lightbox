msgstr ""
"Tlačítka pro sdílení na sociálních médiích pro Facebook, Twitter, Pinterest "
"a přímé sdílení URL."

#: class-ml-slider-lightbox.php:4100 class-ml-slider-lightbox.php:4270
msgid "Enable Pager"
msgstr "Povolit stránkování"

#: class-ml-slider-lightbox.php:4101
