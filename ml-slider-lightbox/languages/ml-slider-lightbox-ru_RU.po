msgstr "Развернуть"

#: class-ml-gallery.php:2624
msgid "Share"
msgstr "Поделиться"

#: class-ml-gallery.php:2625 class-ml-slider-lightbox.php:4676
msgid "Likes"
msgstr "Лайки"

#: class-ml-gallery.php:2626
msgid "Autoplay"
msgstr "Автовоспроизведение"

#: class-ml-gallery.php:2627
msgid "Rotate and Flip"
msgstr "Повернуть и отразить"

#: class-ml-gallery.php:2628
msgid "Fullscreen"
msgstr "На весь экран"

#: class-ml-gallery.php:2634
msgid "Unique Image URLs"
msgstr "Уникальные URL изображений"

#: class-ml-gallery.php:2641 class-ml-slider-lightbox.php:2364
#: class-ml-slider-lightbox.php:2426
msgid "Appearance"
msgstr "Внешний вид"

#: class-ml-gallery.php:2644
msgid "Background color of the gallery window"
msgstr "Цвет фона окна галереи"

#: class-ml-gallery.php:2654
msgid "How opaque the gallery window background is (0 = transparent, 1 = solid)"
msgstr "Насколько непрозрачный фон окна галереи (0 = прозрачный, 1 = сплошной)"

#: class-ml-gallery.php:2669
msgid "Border width in pixels around the carousel (0 = no border)"
msgstr "Ширина рамки в пикселях вокруг карусели (0 = без рамки)"

#: class-ml-gallery.php:2670
