msgstr ""
"Aangepaste tekst voor gallery-knoppen. Deze tekst verschijnt op alle \"Open "
"in Gallery\"-knoppen op de site."

#: class-ml-slider-lightbox.php:3156 class-ml-slider-lightbox.php:3182
#: class-ml-slider-lightbox.php:3156
#: class-ml-slider-lightbox.php:3182
msgid "Top Right (Default)"
msgstr "Rechtsboven (Standaard)"

#: class-ml-slider-lightbox.php:3169
#: class-ml-slider-lightbox.php:3169
msgid "Choose where to position the close button (X) in the gallery overlay."
msgstr "Kies waar de sluitknop (X) in de gallery-overlay moet worden geplaatst."

#: class-ml-slider-lightbox.php:3195
#: class-ml-slider-lightbox.php:3195
msgid ""
"Choose where to position \"Open in Gallery\" buttons within slides, images, "
"galleries, and videos."
msgstr ""
"Kies waar \"Open in Gallery\"-knoppen binnen dia's, afbeeldingen, galleries "
"en video's moeten worden geplaatst."

#: class-ml-slider-lightbox.php:3200
#: class-ml-slider-lightbox.php:3200
