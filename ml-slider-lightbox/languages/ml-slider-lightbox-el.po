msgid "The option was successfully updated"
msgstr "Η επιλογή ενημερώθηκε επιτυχώς"

#: admin/Notices.php:241
msgid "The requested data does not exist."
msgstr "Τα ζητούμενα δεδομένα δεν υπάρχουν."

