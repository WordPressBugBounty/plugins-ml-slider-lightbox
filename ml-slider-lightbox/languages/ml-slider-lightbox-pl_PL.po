msgstr "W"

#: class-ml-gallery.php:2368
msgid "Custom height"
msgstr "Niestandardowa wysokość"

#: class-ml-gallery.php:2372
msgid "Crop to fill the exact size instead of scaling to fit within it"
msgstr ""
"Przytnij, aby wypełnić dokładny rozmiar zamiast skalować, aby dopasować się "
"do niego"

#: class-ml-gallery.php:2372
msgid "Crop to exact size"
msgstr "Przytnij do dokładnego rozmiaru"

