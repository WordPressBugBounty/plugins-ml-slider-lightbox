msgstr "Barva ozadja za gumb prejšnjega in naslednjega navigacijskega puščice."

#: class-ml-slider-lightbox.php:3235
#: class-ml-slider-lightbox.php:3235
msgid ""
"Background color for arrow buttons when hovering. Creates visual feedback "
